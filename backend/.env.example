# Copy this file to .env and replace every placeholder before starting the API.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Configure a separate administrator account. No default admin account exists.
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=mahesh@gmail.com
ADMIN_PASSWORD=M@hesh.9898

# Local development defaults. Use your deployed frontend origins in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./placement.db
UPLOAD_DIR=uploads/resumes
MAX_RESUME_SIZE_BYTES=10485760
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENABLE_OCR=false
